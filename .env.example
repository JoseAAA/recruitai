# =====================================================================
# RecruitAI — Configuración
# =====================================================================
# Copia este archivo como .env y configúralo. Defaults en
# backend/app/core/config.py.
#
# Para arrancar el sistema, NO uses `docker compose up` directamente — usa
# el script wrapper que detecta tu LLM_PROVIDER y levanta lo necesario:
#
#   Windows:  .\scripts\start.ps1
#   Linux:    ./scripts/start.sh
#

# =====================================================================
# 🎯 VARIABLE PRINCIPAL — CAMBIA SOLO ESTO PARA SWITCHEAR DE MOTOR DE IA
# =====================================================================
#
# Una variable controla tres cosas a la vez:
#   1. Qué motor de IA procesa los CVs (Ollama local / Groq / Gemini / OpenAI)
#   2. Si se activa PII masking automáticamente (auto-ON para cloud)
#   3. Si Ollama arranca como contenedor o no (ahorra ~3 GB RAM + GPU)
#
# Opciones:
#   ollama   → 100% local, datos nunca salen. Gratis. Requiere GPU NVIDIA.
#   groq     → Cloud, ultrarrápido (5-10x), Llama 3.3 70B. Free tier.
#   gemini   → Cloud Google, free tier 1.5k req/día.
#   openai   → Cloud OpenAI, máxima calidad pero más caro.

LLM_PROVIDER=ollama

# =====================================================================
# API KEYS — solo la del proveedor que escogiste arriba
# =====================================================================
# Si LLM_PROVIDER=ollama, ignora esta sección.
# Si LLM_PROVIDER=cloud, configura la key correspondiente o el backend
# se negará a arrancar (sin fallback silencioso a Ollama).

# Groq — gratis: https://console.groq.com
GROQ_API_KEY=

# Gemini — gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — pago: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =====================================================================
# Modelos (opcional — defaults sensatos en config.py)
# =====================================================================
# Solo descomenta y cambia si quieres un modelo distinto al default.

# OLLAMA_MODEL=gemma3:4b                                       # gemma3:4b | qwen3:4b | llama3.2:3b
# GROQ_MODEL=llama-3.3-70b-versatile                           # Default (Scout devuelve JSON inestable)
# GEMINI_MODEL=gemini-2.5-flash                                 # (2.0-flash fue apagado por Google el 01-jun-2026)
# GEMINI_MIN_REQUEST_INTERVAL=6.0                               # Marcapasos free tier (seg entre llamadas). 0 = sin pausa (tier pagado)
# OPENAI_MODEL=gpt-4o-mini

# =====================================================================
# 🔎 Embeddings — SIEMPRE LOCAL, INDEPENDIENTE del LLM
# =====================================================================
# La búsqueda semántica corre en su propio contenedor (servicio "embeddings"
# en docker-compose.yml, imagen TEI de Hugging Face). Esto significa:
#
#   - Si cambias LLM_PROVIDER de Ollama a cloud, las embeddings SIGUEN
#     funcionando — no dependen del LLM.
#   - El servicio embeddings corre en CPU, consume ~600 MB RAM, latencia
#     ~30-50 ms por texto.
#
# Normalmente NO necesitas tocar estas variables. Los defaults son óptimos.

# Modelo: Snowflake/snowflake-arctic-embed-m-v2.0
#   - 768 dim (coincide con Qdrant actual — no requiere re-indexar)
#   - Apache 2.0, multilingüe (ES/EN/DE/FR/IT) — top tier para CVs en español
# EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-m-v2.0

# Host del servicio embeddings (red interna Docker, no tocar salvo deploy raro)
# EMBEDDINGS_HOST=http://embeddings:8080

# =====================================================================
# PII Masking — opcional, normalmente NO tocar
# =====================================================================
# Por defecto se auto-deriva de LLM_PROVIDER:
#   ollama → OFF (datos nunca salen, masking sería overhead inútil)
#   cloud  → ON  (LPDP Perú obliga a enmascarar antes de enviar fuera)
#
# Solo descomenta si quieres forzar el comportamiento contrario.
# PII_MASKING_ENABLED=true

# ENCRYPTION_KEY — requerida si PII masking está activo (auto u override).
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# =====================================================================
# Base de datos & seguridad
# =====================================================================
POSTGRES_USER=recruitai
POSTGRES_PASSWORD=recruitai_secret
POSTGRES_DB=recruitai_db

# JWT — generar con: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this

# Usuarios iniciales — CAMBIAR EN PRODUCCIÓN
ADMIN_INITIAL_PASSWORD=change-me-on-first-run
RECRUITER_INITIAL_PASSWORD=change-me-on-first-run

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Entorno: development | production
# En production, el backend rechaza arrancar si detecta defaults inseguros.
ENVIRONMENT=development

# =====================================================================
# Frontend
# =====================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
